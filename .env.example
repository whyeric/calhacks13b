# Copy to .env and fill in. Never commit .env.

# Empty key = deterministic fallback agent (no crash).
ANTHROPIC_API_KEY=
# Pinned model id; required when ANTHROPIC_API_KEY is set. Never "latest".
ANTHROPIC_MODEL=claude-sonnet-5-5

KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# 1 blocks all outbound HTTP (cache only).
DEMO_OFFLINE=0
# 1 seeds the example "sample week" hedges into an empty db, flagged as sample on GET /health
# (sample_week, sample_businesses); a desk run replaces them with the real pipeline's output.
# 0 starts with no example hedges, so the dashboard shows only real desk runs.
DEMO_SAMPLE_WEEK=1
DATABASE_URL=sqlite:///./hedge_desk.db
WEEKLY_BUDGET_DEFAULT=250
# Assumed average check for the restaurant (labeled "assumed" in the UI).
AVG_CHECK_USD=35
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional; empty = owner auth off.
OWNER_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
