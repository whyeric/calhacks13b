# Copy to .env and fill in. Never commit .env.

# Empty key = deterministic fallback agent (no crash).
ANTHROPIC_API_KEY=
# Pinned model id; required when ANTHROPIC_API_KEY is set. Never "latest".
ANTHROPIC_MODEL=claude-sonnet-5-5

KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# 1 blocks all outbound HTTP (cache only).
DEMO_OFFLINE=0
# 1 seeds the example "sample week" hedges into an empty db, flagged as sample on GET /health
# (sample_week, sample_businesses); a desk run replaces them with the real pipeline's output.
# 0 starts with no example hedges, so the dashboard shows only real desk runs.
DEMO_SAMPLE_WEEK=1
# Pinned "as of" time (ISO, UTC), e.g. 2026-10-24T19:00:00Z: the clock starts there and the desk
# week and offline market matching follow the cached demo week. Empty = the real clock.
# `make demo` sets it to the week fixtures/kalshi_cache/ was warmed for.
DEMO_AS_OF=
DATABASE_URL=sqlite:///./hedge_desk.db
WEEKLY_BUDGET_DEFAULT=250
# Assumed average check for the restaurant (labeled "assumed" in the UI).
AVG_CHECK_USD=35
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Role tokens; empty = that check is off. `make demo` / `make dev` set demo values
# (demo-owner / demo-controller) so the API refuses anyone without the right role's token.
OWNER_TOKEN=
# The controller co-signs hedges above materiality and closes the books.
CONTROLLER_TOKEN=

# QuickBooks Online (docs/QUICKBOOKS.md). Leave the id/secret empty (or DEMO_OFFLINE=1) for the
# SYNTHETIC demo company; set both, from an Intuit developer app, to connect real books.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/integrations/quickbooks/callback
# sandbox | production
QBO_ENVIRONMENT=sandbox
# Where the OAuth callback redirects the browser afterwards.
FRONTEND_URL=http://localhost:3000

# Increase bank (docs/INCREASE.md): the bank leg of reconciliation. Leave empty (or DEMO_OFFLINE=1)
# for the simulated bank CSV. A sandbox key + account from `scripts/stage_increase_sandbox.py`
# makes the bank leg a real (sandbox) bank.
INCREASE_API_KEY=
INCREASE_ACCOUNT_ID=
# sandbox | production
INCREASE_ENVIRONMENT=sandbox

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
